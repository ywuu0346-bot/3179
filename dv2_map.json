{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 500,
  "title": "Australia Rainfall (past 36 months)",
  "projection": {"type": "mercator", "center": [134, -25], "scale": 850},
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {"type": "geoshape", "fill": "#eaf6ff"}
    },
    {
      "data": {"graticule": {"step": [20, 20]}},
      "mark": {"type": "geoshape", "stroke": "#b0c4cf", "strokeWidth": 0.6, "opacity": 0.55}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/ywuu0346-bot/3179/refs/heads/main/STE_2021_AUST_GDA2020.json",
        "format": {"type": "topojson", "feature": "states and boundries"}
      },
      "mark": {"type": "geoshape", "fill": "#f7f7f7"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/ywuu0346-bot/3179/refs/heads/main/rainfall.2025-08-31.36month.aus.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude (°)": "number",
            "Longitude (°)": "number",
            "Rainfall (mm)": "number",
            "Percentile": "number"
          }
        }
      },
      "mark": {"type": "circle", "opacity": 0.75, "stroke": "white", "strokeWidth": 0.5},
      "encoding": {
        "longitude": {"field": "Longitude (°)", "type": "quantitative"},
        "latitude": {"field": "Latitude (°)", "type": "quantitative"},
        "size": {
          "field": "Rainfall (mm)",
          "type": "quantitative",
          "title": "Total rainfall (mm, 36 months)",
          "scale": {"type": "sqrt", "range": [6, 420]},
          "legend": {"format": ",.0f"}
        },
        "color": {
          "field": "Percentile",
          "type": "quantitative",
          "title": "Percentile vs history",
          "scale": {"scheme": "blues", "domain": [0, 100]},
          "legend": {"format": ".0f"}
        },
        "tooltip": [
          {"field": "Region", "title": "State / Territory"},
          {"field": "Rainfall (mm)", "title": "Total rainfall (mm)", "format": ",.0f"},
          {"field": "Percentile", "title": "Percentile", "format": ".0f"},
          {"field": "Latitude (°)", "title": "Latitude (°)", "format": ".2f"},
          {"field": "Longitude (°)", "title": "Longitude (°)", "format": ".2f"}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/ywuu0346-bot/3179/refs/heads/main/STE_2021_AUST_GDA2020.json",
        "format": {"type": "topojson", "feature": "states and boundries"}
      },
      "mark": {"type": "geoshape", "fill": null, "stroke": "#607d8b", "strokeWidth": 0.9, "opacity": 0.9}
    }
  ]
}
